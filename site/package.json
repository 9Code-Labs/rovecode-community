{
  "name": "rovecode-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/facts.mjs && node scripts/docs-build.mjs && bun scripts/market.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "render-frames": "bun run scripts/render-frames.ts",
    "shoot": "node scripts/shoot.ts",
    "images": "node scripts/images.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og": "node scripts/og.mjs",
    "live-check": "node scripts/live-check.mjs",
    "browsers-check": "node scripts/browsers-check.mjs",
    "build:docs": "cross-env VITE_DOCS=1 bun run build",
    "build:all": "cross-env VITE_DOCS=1 VITE_MARKET=1 bun run build",
    "test:market-docs": "bun test scripts/market-docs.test.mjs",
    "test:docs": "bun test scripts/docs-build.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^10.1.0",
    "marked": "^18.0.11",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
