{
  "compilerOptions": {
    // ES2024: vendored pi-tui uses /v regex flags (vendor/pi-tui/src/utils.ts:40-48)
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    // matches upstream pi-tui build semantics (their tsconfig.base.json) — Bun's
    // transpiler reads this flag, so it affects vendored class RUNTIME behavior
    "useDefineForClassFields": false,
    "noEmit": true
  },
  "include": ["src", "test"]
}
