{
  "name": "aion",
  "version": "0.2.0",
  "description": "Research-derived agent harness on Bun/TypeScript: 20 evidence-based ports from open-source harnesses (TUI, MCP, ACP, headless server, repo-map, shadow-git checkpoints, execpolicy, model routers).",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "aion": "src/cli/main.ts"
  },
  "files": [
    "src",
    "vendor",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "gauntlet": "bun run src/eval/gauntlet.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/models": "^0.0.61",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "diff": "^9.0.0",
    "get-east-asian-width": "1.6.0",
    "gpt-tokenizer": "^4.0.0",
    "marked": "18.0.5",
    "tokenlens": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@xterm/headless": "5.5.0",
    "typescript": "^5"
  }
}
